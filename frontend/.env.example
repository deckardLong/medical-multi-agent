# Chỉ cần khi deploy (Vercel): địa chỉ backend, KHÔNG có dấu / ở cuối và không có /api.
# Dev local để trống → dùng Vite proxy /api → http://127.0.0.1:8000
# VITE_API_BASE=https://aurelia-api.onrender.com

# Đăng nhập Google / Facebook (giá trị công khai). Trống → ẩn nút tương ứng.
# Google: OAuth client loại "Web application"; thêm origin của frontend vào "Authorized JavaScript origins".
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=1234567890
# VITE_FACEBOOK_SDK_VERSION=v26.0

# Email liên hệ hiện trên /privacy, /terms, /data-deletion (Meta yêu cầu kênh liên hệ để xoá dữ liệu)
# VITE_CONTACT_EMAIL=ban@example.com
