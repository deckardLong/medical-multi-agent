# Copy file này thành .env rồi điền key: `cp .env.example .env` (.env đã nằm trong .gitignore)

# ===================== product/ (FastAPI) — tiền tố PRODUCT_ =====================
# Khớp docker-compose (user/pass/product). Lưu ý: alembic.ini có URL psycopg2 riêng, không đọc biến này
PRODUCT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/product
# Chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(48))"
PRODUCT_JWT_SECRET=change-me
PRODUCT_JWT_EXPIRE_MINUTES=1440

# LLM qua endpoint tương thích OpenAI (mặc định Ollama local; api_key với Ollama điền gì cũng được)
PRODUCT_LLM_BASE_URL=http://localhost:11434/v1
PRODUCT_LLM_API_KEY=ollama
PRODUCT_LLM_MODEL=qwen2.5:7b-instruct
PRODUCT_VLM_MODEL=qwen2.5vl:7b
# Model VLM thứ 2 cho agent vlm_transcribe (khác PRODUCT_VLM_MODEL để 2 lần đọc độc lập); trống = dùng PRODUCT_VLM_MODEL
# PRODUCT_VLM_TRANSCRIBE_MODEL=

# Bắt buộc cho web_search_tool (https://tavily.com); để trống thì tool trả "chưa được cấu hình"
PRODUCT_TAVILY_API_KEY=your-product-tavily-api-key-here

PRODUCT_STORAGE_DIR=storage
PRODUCT_TIMEZONE=Asia/Ho_Chi_Minh

# ===================== retrieval/ + corpus_sync/ — không tiền tố =====================
# Cần cho corpus_sync.run_fetch (repo HF private / tránh rate limit)
# HF_TOKEN=
# HF_CORPUS_REPO=<owner>/<dataset-repo>

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Đường dẫn tương đối tính từ thư mục gốc repo
R2AI_CONFIG_DIR=configs
R2AI_CORPUS_DIR=corpus
R2AI_DERIVED_DIR=derived
R2AI_STATE_DIR=state
# Tên thư mục trong configs/exp/ để deep-merge config thử nghiệm; để trống = config gốc
# R2AI_EXPERIMENT=

# LLM_API_KEY=
# LLM_MODEL=